config_version=5

[application]

config/name="Kart Lab"
config/icon="res://branding/icon.svg"
config/description="Incomplete engineering reconstruction using recovered data; native parity unverified."
run/main_scene="res://scenes/frontend.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Required by Godot for Android export (docs/RE-SETUP.md troubleshooting).
textures/vram_compression/import_etc2_astc=true

[display]

window/handheld/orientation=0

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[input]

steer_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
steer_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
accelerate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":5,"axis_value":-1.0)]
}
handbrake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
reset_kart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
use_item={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}

[input_devices]

pointing/emulate_mouse_from_touch=true
