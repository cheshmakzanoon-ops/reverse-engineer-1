# ---------------------------------------------------------------------------
# Lookup API
#
# The port addresses definitions the way the game does -- by id string, e.g.
# `GameDB.get("KartPhysicsHandlingDefault")` or
# `GameDB.get("Kart_SO_TerraFormula1")["_seasonDefinitionRef"]["_refID"]`.
# ---------------------------------------------------------------------------


## Resolve a definition by its recovered id. Returns {} when unknown, so
## callers can do `if not GameDB.lookup(id).is_empty()` instead of null checks.
##
## Named `lookup`, not `get`, because Object already owns `get(property)` and
## shadowing it breaks static type resolution at every call site.
static func lookup(id: String) -> Dictionary:
	var meta: Dictionary = INDEX.get(id, {})
	if not meta.is_empty():
		# Returns the domain's id -> definition table directly rather than the
		# script: a GDScript object's constants are not reachable by property
		# access, so `domain.BY_ID` fails at runtime.
		return get_domain(meta["domain"]).get(id, {})
	# Fall back to a case-insensitive match. The shipped data needs it: five
	# chapters (Chapter_Prologue_1 and the four Chapter_Legend_* entries)
	# reference `_ipDefinitionRef` = "IP_GENERIC" while the definition that
	# actually ships is "IP_Generic". The original game resolves these -- its
	# single-player menu works -- so its definition lookup cannot be
	# case-sensitive. Matching the original here rather than "fixing" the
	# reference keeps the recovered data byte-for-byte and makes the port behave
	# like the game it is a port of.
	var folded := id.to_lower()
	for known in INDEX:
		if (known as String).to_lower() == folded:
			return get_domain(INDEX[known]["domain"]).get(known, {})
	return {}


## Does this id exist in the recovered database? Case-insensitive, matching
## `lookup`.
static func has_def(id: String) -> bool:
	return not lookup(id).is_empty()


## Every definition of one class, as id -> definition. `cls` is the bare class
## name, e.g. "MapDefinition".
static func by_class(cls: String) -> Dictionary:
	var out := {}
	for id in INDEX:
		if (INDEX[id]["class"] as String).ends_with("." + cls):
			out[id] = lookup(id)
	return out


## Ids of one class, in database order.
static func ids_of_class(cls: String) -> Array:
	var out := []
	for id in INDEX:
		if (INDEX[id]["class"] as String).ends_with("." + cls):
			out.append(id)
	return out


## Follow a `_refID` field: `resolve(def, "_seasonDefinitionRef")` returns the
## definition that field names, or {} if it is empty or dangling. This is the
## one call the port needs to walk the whole game data graph.
static func resolve(def: Dictionary, field: String) -> Dictionary:
	var ref: Dictionary = def.get(field, {})
	var id: String = ref.get("_refID", "")
	return lookup(id) if id != "" else {}


## The id -> definition table for one data domain. Returns {} for an unknown
## domain name.
static func get_domain(domain: String) -> Dictionary:
	match domain:
		"handling":
			return handling.BY_ID
		"catalog":
			return catalog.BY_ID
		"pickups":
			return pickups.BY_ID
		"modes":
			return modes.BY_ID
		"misc":
			return misc.BY_ID
	return {}


## True if `value` is a recovered AnimationCurve rather than ordinary data.
static func is_curve(value) -> bool:
	return handling.is_curve(value)


## Build a live Curve from recovered keyframes. Cached per call site is the
## caller's business -- curves are cheap but not free, and the recovered set is
## large.
static func curve(value) -> Curve:
	if not is_curve(value):
		push_warning("GameDB.curve() on non-curve value")
		return Curve.new()
	return handling.make_curve(value["__curve__"])


## Sample a recovered curve without materialising a Curve. Falls back to
## `fallback` for a non-curve so callers never have to branch.
static func sample(value, t: float, fallback: float = 0.0) -> float:
	if not is_curve(value):
		return fallback
	var c: Curve = handling.make_curve(value["__curve__"])
	# sample_baked() takes no fallback and clamps out-of-domain reads, which
	# would hide a caller asking for a time the curve never covers. Clamping a
	# driving curve silently is exactly the kind of bug that only shows up as a
	# kart that will not accelerate, so the caller decides instead.
	if t < c.min_domain or t > c.max_domain:
		return fallback
	return c.sample_baked(t)
