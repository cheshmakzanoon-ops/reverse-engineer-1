# Reverse-engineering build artifacts — regenerate, don't commit.

# Ghidra headless project directories and decompiler output
*.gpr
*.rep/
/ghidra-proj/
decompiled*.c
*.decompiled.c
strings-out/
functions.txt

# rizin / radare2 analysis state
*.rzdb
*.rzbak
rz-project/
.rz/

# binwalk / firmware extraction output
_binwalk/
*_extracted/
*.squashfs
*.jffs2*
*.ubifs*

# Captures and scratch
*.pcap
*.pcapng
/scratch/
/tmp/

# NOTE: do not add a bare `/work/` here. Git cannot re-include a file whose
# parent directory is excluded, so `/work/` would make the negations below
# unreachable. `/work/*` excludes the contents without excluding the directory
# itself, which is what makes the versioning below work.

# The recovered GAME DATA is versioned, because it is the deliverable: it is
# what the Godot port is built from, and reviewing it should not require
# re-running the extraction over a 1.2 GB DMG.
#
# Only the authoritative datasets are kept. Two bulky intermediates stay
# ignored because they are the same information in a worse layout and the
# committed tools regenerate them byte-identically:
#   work/assets/definitions/by_class/  814 per-definition JSONs -- a mechanical
#                                      split of definitions.json
#   work/assets/scenes/*/scene.json    raw scene graphs, 24 MB, whose resolved
#                                      form is tracks.json
/work/*
!/work/assets/
!/work/assets/definitions/
!/work/assets/definitions/definitions.json
!/work/assets/definitions/index.json
!/work/assets/definitions/name_table.json
/work/assets/definitions/by_class/
/work/assets/scenes/
!/work/assets/tracks.json

# Stale partial dump (3 of 55 classes) written by an older version of
# tools/unity_defs_to_gdscript.py. Superseded by definitions.json, which covers
# it in full; the tool no longer writes this file or references it.
/work/assets/definitions_raw.json

# DMG / macOS extraction artifacts — large, licensed, and regenerable.
# Exception: games/ holds the source .dmg we deliberately version via Git LFS
# (see .gitattributes). Derived images stay ignored.
*.dmg
*.img
!games/*.dmg
*.sparseimage
/mnt/
*.app/
*.pkg
*.mpkg

# Godot + Android build output
/build/
*.apk
*.aab
*.idsig
.godot/
android/
*.keystore
!debug.keystore.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS noise
.DS_Store
Thumbs.db